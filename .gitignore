# Node / сборка (на случай перехода на сборщик)
node_modules/
dist/
.vite/

# Локальные секреты
.env
.env.*
!.env.example

# Логи и временные файлы
*.log
.DS_Store
Thumbs.db

# среды Python (если понадобится бэкенд)
.venv/
__pycache__/
*.pyc

# Переезд на хостинг (sweb): секреты и ключи не коммитим
sweb-migration/deploy.env
sweb-migration/deploy.env.*
sweb-migration/deploy.env.txt
sweb-migration/metrica.env
sweb-migration/metrica.env.*
!sweb-migration/metrica.env.example
sweb-migration/id_sweb
sweb-migration/id_sweb.*
sweb-migration/*.bak

# Данные счётчика посещений (api/stats.php): рабочие файлы сервера,
# локально появляются только при проверках
api/data/

# Данные админ-панели: рабочие файлы сервера, в git не нужны
# (папки и .htaccess-заглушки держим в репозитории)
content/users.json
content/media.json
content/articles.json
content/banners.json
content/ads.json
content/links.json
content/backlinks.json
content/outreach.json
content/reviews.json
content/settings.json
content/messages.json
content/reminders.json
content/seo.json
content/secrets.json
content/changes.json
content/pgen-items.json
content/pgen-parties.json
content/pgen-clusters.json
content/mail-unread.json
cacert.pem

# Загрузки владельца через раздел «Медиа-файлы»: рабочие картинки сайта, в git не нужны
media/uploads/*
!media/uploads/.htaccess
content/security/*.json
content/security/*.txt
content/logs/*.json
content/logs/*.log

# Резервные копии сайта: архивы делает панель, в git они не нужны
# (папку и .htaccess-заглушку держим в репозитории)
backups/*.zip
backups/files/

# Локальные резервные копии перед массовыми правками (протокол запуска)
_backup/

# Данные, которые панель собирает сама (популярное, лента)
/popular.json
backups/
_archive/

# SEO-модуль панели (content/seo): ключ сервисного аккаунта Google и база GSC
# содержат приватный ключ и токены — серверные секреты, в git не попадают.
# Саму папку и .htaccess-заглушку держим в репозитории.
content/seo/*
!content/seo/.htaccess

# Ключ сервисного аккаунта Google, скачанный из консоли (лежит в корне сайта)
/calc-doc-seo-*.json
/client_secret*.json

# Рабочий кэш Метрики и резервные копии данных панели
content/metrika-cache.json
content/*.bak-*

# Отладочные выгрузки настроек сервера (могут содержать токены)
shots/_server-secrets*.json

