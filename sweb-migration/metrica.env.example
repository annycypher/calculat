# Скопируйте этот файл в metrica.env (рядом) и заполните своими значениями.
# ВАЖНО: metrica.env не коммитится в git и никуда не публикуется (см. .gitignore).
# Файл нужен только инструменту _game-test\metrica-goals-api.ps1 — заведение целей через API Метрики.

# ClientID и секрет приложения Яндекс.OAuth (создаётся на oauth.yandex.ru, тип «Для доступа к API
# или отладки», доступ metrika:write). ClientID — не секрет, секрет — да: он нужен только для обмена
# кода подтверждения на токен и хранится в рабочем файле metrica.env.
METRIKA_CLIENT_ID=вставьте_client_id
METRIKA_CLIENT_SECRET=вставьте_client_secret

# Токен появится сам после обмена кода: powershell -File _game-test\metrica-token-from-code.ps1 -Code <код>
METRIKA_TOKEN=вставьте_токен_сюда

# Номер счётчика, в котором заводим цели (112558731 — счётчик сайта calc-doc.ru).
METRIKA_COUNTER=112558731
