# Скопируйте этот файл в metrica.env (рядом) и заполните своими значениями.
# ВАЖНО: metrica.env не коммитится в git и никуда не публикуется (см. .gitignore).
# Файл нужен только инструменту _game-test\metrica-goals-api.ps1 — заведение целей через API Метрики.

# OAuth-токен Яндекс.Метрики с правом metrika:write.
# Как получить: oauth.yandex.ru -> «Создать приложение» -> «Для доступа к API или отладки» ->
# отметить доступ metrika:write -> скопировать ClientID -> открыть в браузере
#   https://oauth.yandex.ru/authorize?response_type=token&client_id=<ClientID>
# и скопировать выданный токен.
# Токен даёт доступ к управлению счётчиками аккаунта — храните только в этом файле.
METRIKA_TOKEN=вставьте_токен_сюда

# Номер счётчика, в котором заводим цели (112558731 — счётчик сайта calc-doc.ru).
METRIKA_COUNTER=112558731
